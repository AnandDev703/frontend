# =========================================================
# Contract Risk AI - Environment Configuration
# =========================================================

# Google Gemini API Key (Required for live AI contract analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional: provides cloud sync for contract history & auth)
# If left blank, the app will automatically use local browser storage fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
